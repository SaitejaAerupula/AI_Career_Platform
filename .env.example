# Live job discovery settings
# These values guide how recent and where to search for LinkedIn, Naukri, and Glassdoor jobs.
JOB_SEARCH_LOCATION=India
JOB_SEARCH_REGION=in-en
JOB_RECENCY_DAYS=7

# Email delivery configuration (Optional)
# Leave blank if you do not want the app to send analysis reports by email.
SENDER_EMAIL=your_email@example.com
SENDER_PASSWORD=your_app_password_here
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Legacy API keys (optional, not required for the live LinkedIn/Naukri/Glassdoor flow)
ADZUNA_APP_ID=your_adzuna_app_id_here
ADZUNA_APP_KEY=your_adzuna_app_key_here
RAPIDAPI_KEY=your_rapidapi_key_here
